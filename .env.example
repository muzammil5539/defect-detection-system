# Copy to .env and fill in. .env is git-ignored: never commit real keys.
#
# Read by the API container, by `python -m src.serving.storage` (checks your bucket settings) and by
# `python -m src.deploy.publish_model`. For local shells:  set -a; source .env; set +a
# For Docker:  docker run --env-file .env ...   (put comments on their own line, never after a value)

# --- IDrive e2 bucket (any S3-compatible store works) ---
# Copy the endpoint for your bucket's region from the e2 dashboard, under "Enabled regions".
E2_ENDPOINT_URL=https://REPLACE-ME.idrivee2-00.com
E2_BUCKET=REPLACE-ME
# The container only needs READ access to this bucket; publishing needs a separate key with WRITE access.
E2_ACCESS_KEY_ID=
E2_SECRET_ACCESS_KEY=

# Optional, defaults shown.
# E2_MODEL_KEY=models/best_model.onnx
# E2_REGION=us-east-1
# Use "virtual" only if your endpoint insists on bucket.endpoint host names.
# E2_ADDRESSING_STYLE=path

# --- API behaviour (all optional) ---
# When set, POST /predict requires the header X-API-Key.
# API_KEY=
# Below this confidence the response says needs_review: true (send the part to a person).
# LOW_CONFIDENCE_THRESHOLD=0.6
# MAX_UPLOAD_MB=10
# MAX_IMAGE_PIXELS=12000000
# Default: the CPUs available to the process, at most 4.
# ORT_THREADS=2
# MAX_CONCURRENT_INFERENCES=2
# LOG_LEVEL=INFO
# Development only: serve a local .onnx file instead of downloading from the bucket.
# MODEL_PATH=models/best_model.onnx
